# Copiar este archivo como .env y completar solo la contrasena local de MySQL.
# El archivo .env esta ignorado por Git y no debe compartirse.
# IMPORTANTE: antes de editar este archivo, crea la base y el usuario MySQL
# ejecutando database/setup_usuario.sql (ver instrucciones en el README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bd_intikilla
DB_USER=bd_intikilla
DB_PASSWORD=Admin123
API_PORT=3001

# API externa de notificaciones (Resend, https://resend.com - plan gratuito).
# Crea una cuenta gratuita, genera una API key y coloca aqui tus datos.
# Si se dejan vacias, la app sigue funcionando: solo se omite el envio de correo.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=IntiKilla <onboarding@resend.dev>
